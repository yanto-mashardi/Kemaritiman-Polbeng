MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kemaritiman_polbeng
MYSQL_USER=kemaritiman_app
MYSQL_PASSWORD=ganti_dengan_password_database

# Dipakai hanya bila akun ADMIN belum memiliki credential setelah migrasi
# Gunakan secret kuat di environment deployment, jangan commit password nyata.
INITIAL_ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat
